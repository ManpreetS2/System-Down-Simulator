{
  "name": "system-down-simulator",
  "private": true,
  "version": "1.0.0",
  "description": "An interactive incident-response strategy game where players manage software outages while balancing system health, revenue, customer trust, engineering costs, and response time.",
  "author": "Manpreet Singh",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode test",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:engine": "tsx scripts/engine-smoke.ts && tsx scripts/report-smoke.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vite": "^6.0.7"
  }
}
